# EduPulse AI - Local-First Teacher Paper-Generation Platform
# Everything in EduPulse AI is local-first. All user data, books, and papers stay on the client device.
# Teachers can enter their own API keys (Gemini, OpenAI, Anthropic) directly in the app settings,
# which are stored exclusively in their browser's IndexedDB.

# Optional: Default API keys for self-hosted instances (optional fallbacks):
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Optional: Vercel serverless proxy mode (true/false)
VITE_USE_PROXY=false
